{
	"name": "@gopherium/godmin",
	"version": "0.29.0",
	"description": "The admin kit for Gopherium projects: host layer for React admin applications on the WordPress Design System.",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@12.2.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gopherium/godmin.git"
	},
	"keywords": [
		"admin",
		"wordpress",
		"design-system",
		"react",
		"gopherium"
	],
	"files": [
		"dist",
		"docs",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./base.css": "./dist/base.css",
		"./dates": {
			"types": "./dist/dates.d.ts",
			"default": "./dist/dates.js"
		},
		"./dialogs": {
			"types": "./dist/dialogs.d.ts",
			"default": "./dist/dialogs.js"
		},
		"./router": {
			"types": "./dist/router.d.ts",
			"default": "./dist/router.js"
		},
		"./stylelint": {
			"types": "./dist/stylelint.d.ts",
			"default": "./dist/stylelint.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/base.css dist/base.css",
		"cover": "vitest run --coverage --project unit",
		"lint": "oxlint",
		"lint:css": "stylelint 'src/**/*.css'",
		"storybook:dev": "storybook dev",
		"storybook:test": "vitest run --project storybook",
		"test:browser": "vitest run --project browser",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@tanstack/react-router": "^1.170.44",
		"@testing-library/react": "^16.3.2",
		"@wordpress/a11y": ">=4.57.0 <5.0.0",
		"@wordpress/components": ">=42.0.0 <43.0.0",
		"@wordpress/dataviews": ">=20.0.0 <21.0.0",
		"@wordpress/date": ">=5.57.0 <6.0.0",
		"@wordpress/i18n": ">=6.30.0 <7.0.0",
		"@wordpress/icons": ">=18.0.0 <19.0.0",
		"@wordpress/style-runtime": ">=0.13.0 <0.14.0",
		"@wordpress/theme": ">=2.3.0 <3.0.0",
		"@wordpress/ui": ">=0.24.0 <0.25.0",
		"react": "^19.2.0",
		"stylelint": "^16 || ^17",
		"vitest": "^4.1.10 || ^5.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-router": {
			"optional": true
		},
		"@testing-library/react": {
			"optional": true
		},
		"@wordpress/components": {
			"optional": true
		},
		"@wordpress/dataviews": {
			"optional": true
		},
		"@wordpress/date": {
			"optional": true
		},
		"stylelint": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"@argos-ci/storybook": "6.4.4",
		"@storybook/addon-a11y": "10.6.3",
		"@storybook/addon-vitest": "10.6.3",
		"@storybook/react-vite": "10.6.3",
		"@tanstack/react-router": "1.170.45",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/mdast": "4.0.4",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"@wordpress/a11y": "4.57.0",
		"@wordpress/components": "42.0.0",
		"@wordpress/dataviews": "20.0.0",
		"@wordpress/date": "5.57.0",
		"@wordpress/element": "9.0.0",
		"@wordpress/i18n": "6.30.0",
		"@wordpress/icons": "18.0.0",
		"@wordpress/style-runtime": "0.13.0",
		"@wordpress/theme": "2.3.0",
		"@wordpress/ui": "0.24.0",
		"eslint": "^10.7.0",
		"eslint-plugin-jsdoc": "^63.2.0",
		"eslint-plugin-sonarjs": "^4.2.0",
		"eslint-plugin-storybook": "10.6.3",
		"eslint-plugin-tsdoc": "^0.5.2",
		"github-slugger": "2.0.0",
		"jsdom": "^30.1.2",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-to-string": "4.0.0",
		"oxlint": "^1.71.0",
		"playwright": "1.64.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"storybook": "10.6.3",
		"stylelint": "^17.0.0",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.65.0",
		"vitest": "^5.0.3"
	}
}
