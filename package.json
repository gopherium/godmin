{
	"name": "@gopherium/godmin",
	"version": "0.1.0",
	"description": "The admin kit for Gopherium projects: host layer for React admin applications on the WordPress Design System.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gopherium/godmin.git"
	},
	"keywords": [
		"admin",
		"wordpress",
		"design-system",
		"react",
		"gopherium"
	],
	"files": [
		"dist",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"cover": "vitest run --coverage",
		"lint": "oxlint",
		"typecheck": "tsc -b",
		"prepublishOnly": "pnpm run build"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@wordpress/style-runtime": ">=0.8.0 <0.9.0",
		"@wordpress/theme": ">=1.1.0 <2.0.0",
		"@wordpress/ui": ">=0.19.0 <0.20.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.17",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"@wordpress/style-runtime": "0.8.0",
		"@wordpress/theme": "1.1.0",
		"@wordpress/ui": "0.19.0",
		"eslint": "^10.7.0",
		"eslint-plugin-jsdoc": "^63.2.0",
		"eslint-plugin-tsdoc": "^0.5.2",
		"jsdom": "^29.1.1",
		"oxlint": "^1.71.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	}
}
